# ---- APfx HybridDash server configuration ----
# Copy this file to .env and fill in your keys. All keys stay server-side.

PORT=4000

# Database (SQLite via Prisma; swap provider in prisma/schema.prisma for Postgres/Supabase later)
DATABASE_URL="file:./dev.db"

# --- Market data providers (quotes / candles) ---
# Primary: Twelve Data (free tier: https://twelvedata.com)
TWELVEDATA_API_KEY=

# Secondary: Finnhub (free tier: https://finnhub.io) — also used for news
FINNHUB_API_KEY=

# Fallback: Financial Modeling Prep (https://financialmodelingprep.com) — also used for the economic calendar
FMP_API_KEY=

# --- News (optional extra source) ---
# Marketaux (https://marketaux.com)
MARKETAUX_API_KEY=

# --- AI layer ---
# Anthropic API key (https://console.anthropic.com) — powers all "AI Analysis" panels
ANTHROPIC_API_KEY=
# Model used for the AI layer (default claude-opus-4-8)
ANTHROPIC_MODEL=claude-opus-4-8

# Display name used in the dashboard greeting
TRADER_NAME=Akshay
