# ---- APfx HybridDash server configuration ----
# Copy this file to .env and fill in your keys. All keys stay server-side.
# NEVER commit the real .env — it is gitignored. Keep secrets out of git.
#
# MINIMAL SETUP: just ANTHROPIC_API_KEY. Prices/charts default to Yahoo Finance,
# which is KEYLESS and covers the whole watchlist (incl. NQ/ES/WTI futures).
#   - Quotes & charts: Yahoo Finance (no key). Set a market-data key below only
#     if you want a paid fallback or Yahoo is blocked on your network.
#   - News & economic calendar: retrieved live by Claude's web-search tool
#     (the scheduled Macro Agent), so no news/calendar key is needed.

PORT=4000

# Database (SQLite via Prisma; swap provider in prisma/schema.prisma for Postgres/Supabase later)
DATABASE_URL="file:./dev.db"

# --- Market data provider (quotes / candles) — OPTIONAL fallback ---
# Yahoo Finance (keyless) is the default source. These only act as fallback:
# Twelve Data (free tier: https://twelvedata.com)
TWELVEDATA_API_KEY=

# --- Optional dedicated providers (override web search for their layer) ---
# Finnhub (https://finnhub.io) — quotes fallback + news
FINNHUB_API_KEY=
# Financial Modeling Prep (https://financialmodelingprep.com) — quotes fallback + economic calendar
FMP_API_KEY=
# Marketaux (https://marketaux.com) — extra news source
MARKETAUX_API_KEY=

# --- AI layer — REQUIRED ---
# Anthropic API key (https://console.anthropic.com) — powers every "AI Analysis"
# panel AND the live web-search retrieval of news + calendar in hybrid mode.
ANTHROPIC_API_KEY=
# Model used for the AI layer (default claude-opus-4-8; must support the web_search tool)
ANTHROPIC_MODEL=claude-opus-4-8

# Display name used in the dashboard greeting
TRADER_NAME=Trader
