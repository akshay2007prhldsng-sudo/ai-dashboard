# ---- APfx HybridDash server configuration ----
# Copy this file to .env and fill in your key. Keys stay server-side.
# NEVER commit the real .env — it is gitignored.
#
# THE ONLY KEY IS ANTHROPIC_API_KEY. There are no data-API keys:
#   - Prices & charts   -> Yahoo Finance (scraped, keyless)
#   - News feed         -> public RSS (MarketWatch / CNBC / Investing / CoinDesk / Yahoo)
#   - Economic calendar -> ForexFactory public weekly JSON
# The AI (macro + pair agents) interprets that scraped data into the dashboard.

PORT=4000

# Database (SQLite via Prisma; swap provider in prisma/schema.prisma for Postgres/Supabase later)
DATABASE_URL="file:./dev.db"

# --- AI layer — REQUIRED (the only key) ---
# Anthropic API key (https://console.anthropic.com) — powers every AI analysis panel.
ANTHROPIC_API_KEY=
# Model for the AI layer (default claude-opus-4-8)
ANTHROPIC_MODEL=claude-opus-4-8

# Display name used in the dashboard greeting
TRADER_NAME=Trader
